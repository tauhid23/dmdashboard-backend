generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  TRIAL
  NEW_SIGN_UP
}

enum CourseLevel {
  MAKTAB_STAGE_1
  MAKTAB_STAGE_2
  MAKTAB_STAGE_3
  NAZIRAH_STAGE_1
  NAZIRAH_STAGE_2
  NAZIRAH_STAGE_3
  NAZIRAH_STAGE_4
  HIFZ_STAGE_1
  HIFZ_STAGE_2
  HIFZ_STAGE_3
  HIFZ_STAGE_4
}

enum ExamStatus {
  DRAFT
  SUBMITTED
  VOIDED
}

enum ExamOutcome {
  PASSED
  NEEDS_IMPROVEMENT
}

enum ExamScheduleStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum PromotionReason {
  EXAM_PASSED
  MANUAL_ADJUSTMENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                  String                 @id @default(cuid())
  name                String
  email               String
  normalizedEmail     String                 @unique
  username            String
  normalizedUsername  String                 @unique
  passwordHash        String
  status              UserStatus             @default(ACTIVE)
  roleId              String
  mustChangePassword  Boolean                @default(false)
  lastLoginAt         DateTime?
  deletedAt           DateTime?
  sessionVersion      Int                    @default(0)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  role                Role                   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  teacherId           String?                @unique
  studentId           String?                @unique
  teacher             Teacher?               @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  student             Student?               @relation(fields: [studentId], references: [id], onDelete: SetNull)
  sessions            RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  permissionOverrides UserPermissionOverride[]
  auditLogsAsActor    AuditLog[]              @relation("AuditActor")
  auditLogsAsTarget   AuditLog[]              @relation("AuditTarget")
  createdExamAttempts ExamAttempt[]          @relation("ExamCreatedBy")
  courseChanges       StudentCourseHistory[] @relation("CourseChangedBy")
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String           @unique
  description String?
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  resource    String
  action      String
  code        String           @unique
  description String?
  roles       RolePermission[]
  userOverrides UserPermissionOverride[]
  @@unique([resource, action])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model UserPermissionOverride {
  userId       String
  permissionId String
  allowed      Boolean
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([userId, permissionId])
}

model RefreshSession {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  ipAddress   String?
  userAgent   String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  targetUserId String?
  action       String
  ipAddress    String?
  userAgent    String?
  requestId    String?
  before       Json?
  after        Json?
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
}

model Student {
  id                  String                 @id @default(cuid())
  image               String?
  name                String?
  country             String?
  studentSince        DateTime?
  weeklySchedule      String?
  parentName          String?
  parentEmail         String?
  parentPhone         String?
  courseName          String?
  courseStage         String?
  teacherId           String?
  teacherName         String?
  groupClass          Boolean?               @default(false)
  groupSchedule       String?
  groupClassSchedule  String?
  groupTeacher        String?
  groupSubject        String?
  subject             String?
  teacherChanged      Boolean?               @default(false)
  previousTeacherName String?
  teacherChangeReason String?
  status              StudentStatus?         @default(ACTIVE)
  teacher             Teacher?               @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  courses             StudentCourse[]
  teacherChanges      TeacherChange[]
  classReports        ClassReport[]
  classScheduleEvents ClassScheduleEvent[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  currentCourseLevel  CourseLevel?
  courseCompleted     Boolean                @default(false)
  courseUpdatedAt     DateTime?
  examAttempts        ExamAttempt[]
  examSchedules       ExamSchedule[]
  courseHistory       StudentCourseHistory[]
  userAccount         User?

  @@index([teacherId])
}

model StudentCourse {
  id                String   @id @default(cuid())
  studentId         String
  courseInformation String?
  courseStage       String?
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([studentId])
}

model TeacherChange {
  id                  String   @id @default(cuid())
  studentId           String
  previousTeacherName String?
  newTeacherName      String?
  changingReason      String?
  changedAt           DateTime @default(now())
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([studentId])
}

model Teacher {
  id                            String           @id @default(uuid())
  name                          String?
  imageUrl                      String?
  joiningDate                   DateTime?
  status                        TeacherStatus?   @default(ACTIVE)
  strongArea                    String?
  hourlyPayrollRateBdt          Decimal          @default(300.00) @db.Decimal(10, 2)
  totalStudentsAssignedLifetime Int?             @default(0)
  currentActiveStudents         Int?             @default(0)
  studentLeftLifetime           Int?             @default(0)
  students                      Student[]
  classReports                  ClassReport[]
  studentLeftLogs               StudentLeftLog[]
  createdAt                     DateTime         @default(now())
  updatedAt                     DateTime         @updatedAt
  examAttempts                  ExamAttempt[]
  examSchedules                 ExamSchedule[]
  classScheduleEvents           ClassScheduleEvent[]
  payrollCategoryRates          TeacherPayrollCategoryRate[]
  userAccount                   User?
}

model TeacherPayrollCategoryRate {
  id             String   @id @default(cuid())
  teacherId      String
  category       String
  hourlyRateBdt  Decimal  @db.Decimal(10, 2)
  teacher        Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([teacherId, category])
  @@index([teacherId])
}

model ClassScheduleEvent {
  id              String   @id @default(cuid())
  studentId       String
  teacherId       String
  category        String
  scheduledDate   DateTime
  startTime       String
  endTime         String
  durationMinutes Int
  status          String   @default("CONFIRMED")
  attendanceStatus String  @default("UNRECORDED")
  makeupCredit    Boolean  @default(false)
  note            String?
  recurrenceGroupId String?
  recurrenceSourceId String?
  isRecurring     Boolean  @default(false)
  repeatDays      Int[]    @default([])
  repeatIndefinitely Boolean @default(false)
  recurrenceEndDate DateTime?
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher         Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([scheduledDate])
  @@index([studentId, scheduledDate])
  @@index([teacherId, scheduledDate])
  @@index([status, scheduledDate])
  @@index([recurrenceGroupId])
  @@index([recurrenceSourceId])
}

model ExamSchedule {
  id          String             @id @default(cuid())
  studentId   String
  teacherId   String
  courseName  String
  level       String
  scheduledAt DateTime
  status      ExamScheduleStatus @default(UPCOMING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  student     Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher     Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([studentId, scheduledAt])
  @@index([teacherId, scheduledAt])
  @@index([status, scheduledAt])
}

model ExamAttempt {
  id             String                @id @default(cuid())
  studentId      String
  examinerId     String
  courseLevel    CourseLevel
  status         ExamStatus            @default(SUBMITTED)
  outcome        ExamOutcome
  totalScore     Int
  totalMaxScore  Int
  percentage     Decimal               @db.Decimal(5, 2)
  attemptNumber  Int
  notes          String?
  idempotencyKey String                @unique
  createdById    String?
  examRuleId     String?
  examRuleVersion Int?
  submittedAt    DateTime              @default(now())
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  student        Student               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  examiner       Teacher               @relation(fields: [examinerId], references: [id], onDelete: Restrict)
  createdBy      User?                 @relation("ExamCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  examRule       ExamRule?             @relation(fields: [examRuleId], references: [id], onDelete: Restrict)
  marks          ExamMark[]
  sections       ExamSectionResult[]
  promotion      StudentCourseHistory?

  @@unique([studentId, courseLevel, attemptNumber])
  @@index([studentId, submittedAt])
  @@index([examinerId])
  @@index([courseLevel, outcome])
  @@index([examRuleId])
}

model ExamRule {
  id                String            @id @default(cuid())
  courseLevel       CourseLevel
  version           Int
  name              String
  enabled           Boolean           @default(true)
  totalMaximumMarks Int
  passingMarks      Int?
  passingPercentage Decimal?          @db.Decimal(5, 2)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sections          ExamRuleSection[]
  fields            ExamRuleField[]
  attempts          ExamAttempt[]

  @@unique([courseLevel, version])
  @@index([courseLevel, enabled])
}

model ExamRuleSection {
  id             String          @id @default(cuid())
  examRuleId     String
  key            String
  label          String
  maximumMarks   Int
  passingMarks   Int?
  sortOrder      Int
  examRule       ExamRule        @relation(fields: [examRuleId], references: [id], onDelete: Cascade)
  fields         ExamRuleField[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([examRuleId, key])
  @@index([examRuleId, sortOrder])
}

model ExamRuleField {
  id             String          @id @default(cuid())
  examRuleId     String
  sectionId      String
  key            String
  label          String
  description    String?
  maximumMarks   Int
  minimumMarks   Int             @default(0)
  required       Boolean         @default(true)
  sortOrder      Int
  metadata       Json?
  examRule       ExamRule        @relation(fields: [examRuleId], references: [id], onDelete: Cascade)
  section        ExamRuleSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  attemptMarks   ExamMark[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([examRuleId, key])
  @@index([sectionId, sortOrder])
}

model ExamMark {
  id            String      @id @default(cuid())
  examAttemptId String
  fieldKey      String
  label         String
  description   String?
  obtainedMarks Int
  maximumMarks  Int
  sectionKey    String
  sectionLabel  String?
  examRuleFieldId String?
  sortOrder     Int
  createdAt     DateTime    @default(now())
  examAttempt   ExamAttempt @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  examRuleField ExamRuleField? @relation(fields: [examRuleFieldId], references: [id], onDelete: SetNull)

  @@unique([examAttemptId, fieldKey])
  @@index([examAttemptId])
  @@index([examRuleFieldId])
}

model ExamSectionResult {
  id            String      @id @default(cuid())
  examAttemptId String
  sectionKey    String
  sectionLabel  String
  obtainedMarks Int
  maximumMarks  Int
  passingMarks  Int?
  passed        Boolean
  sortOrder     Int @default(0)
  createdAt     DateTime    @default(now())
  examAttempt   ExamAttempt @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)

  @@unique([examAttemptId, sectionKey])
  @@index([examAttemptId])
}

model StudentCourseHistory {
  id            String          @id @default(cuid())
  studentId     String
  fromLevel     CourseLevel?
  toLevel       CourseLevel
  examAttemptId String?         @unique
  reason        PromotionReason
  changedById   String?
  createdAt     DateTime        @default(now())
  student       Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  examAttempt   ExamAttempt?    @relation(fields: [examAttemptId], references: [id], onDelete: Restrict)
  changedBy     User?           @relation("CourseChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
}

model ClassReport {
  id          String  @id @default(cuid())
  month       String?
  studentId   String?
  teacherId   String?
  studentName String?
  teacherName String?

  studentWebcamOn       Boolean?
  studentWebcamPosition String?
  studentWebcamQuality  String?
  studentNoiseFree      String?
  studentDevice         String?
  studentDressup        String?
  attentionFocus        String?
  activityInClass       String?
  lessonUnderstanding   String?
  languageUnderstanding String?
  teacherNote           String?

  teacherWebcamOn       Boolean?
  teacherWebcamPosition String?
  teacherWebcamQuality  String?
  recommendedHeadphone  String?
  teacherNoiseFree      String?
  tutorDevice           String?
  tutorDressup          String?
  teachingFocus         String?
  teachingTone          String?
  toolsAndContentUse    String?
  studentInteraction    String?
  correctionQuality     String?
  adminNote             String?

  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([teacherId])
  @@index([month])
  @@index([createdAt, id])
  @@index([studentId, createdAt])
  @@index([teacherId, createdAt])
  @@index([month, createdAt])
}

model StudentLeftLog {
  id            String   @id @default(uuid())
  teacherId     String
  studentName   String?
  leavingReason String?
  teacher       Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([teacherId])
}
