NODE_ENV=development
PORT=5001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dmdashboard?schema=public"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
FRONTEND_ORIGIN="http://localhost:5173"
AUTH_SECRET="replace-with-at-least-32-random-characters"
SUPER_ADMIN_EMAIL="admin@admin.com"
SUPER_ADMIN_USERNAME="admin@admin.com"
SUPER_ADMIN_PASSWORD="SuperAdmin1"

# Set true only after replacing the example values with your SMTP provider's credentials.
EMAIL_ENABLED=false
# Examples: smtp.gmail.com (Gmail) or smtp-relay.brevo.com (Brevo).
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
# Use true for implicit TLS (normally port 465); false for STARTTLS (normally port 587).
SMTP_SECURE=false
# Fail instead of sending if TLS cannot be established.
SMTP_REQUIRE_TLS=true
# Provider SMTP login, which may differ from the visible sender address.
SMTP_USER="smtp-username"
# Gmail: app password. Brevo: SMTP key. Never use your normal account password here.
SMTP_PASSWORD="smtp-password-or-app-password"
EMAIL_FROM_NAME="Deeni Madrasa"
EMAIL_FROM_ADDRESS="notifications@example.com"
# Optional fallback distribution list. Active Admin, Super Admin and Moderator (manager) emails are included automatically.
ADMIN_NOTIFICATION_EMAILS=""
# Set only to the exact number of trusted reverse proxies in your deployment, for IP rate limits.
TRUST_PROXY_HOPS=0
