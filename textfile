                  </button>

                  <p className="mt-3 text-[11px] text-slate-400">
                    All marks must be entered before submission.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Hint */}
        {(!teacherName.trim() || !studentName.trim() || !allFilled) && (
          <p className="text-xs text-[#94a3b8] text-center">
            {!teacherName.trim() || !studentName.trim()
              ? "Enter teacher and student names to proceed."
              : "Select marks for all subjects to submit."}
          </p>
        )}
      </div>
    </div>
  );
}
