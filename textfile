                  ))}
                </tr>

                {/* Row 3: Descriptions */}
                <tr className="bg-[#f5fafa]">
                  {COLUMNS.map((col) => (
                    <td
                      key={col.key}
                      className="text-center text-xs text-[#475569] py-2 px-2 border border-[#cde0e0] leading-tight"
                    >
                      {col.description}
                    </td>
                  ))}
                </tr>
              </thead>

              <tbody>
                {/* Dropdown row */}
