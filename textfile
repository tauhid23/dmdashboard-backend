              <button
                onClick={onBack}
                className="flex-1 py-2.5 rounded-xl bg-[#17a2b8] text-white text-sm font-medium hover:bg-[#1190a4] transition-colors"
              >
                Back to Exams
              </button>
            )}
          </div>
        </div>
      </div>
    );
