export default function AfterSchoolMaktabStage2({
  onBack,
  initialTeacherName = "",
  initialStudentName = "",
}: {
  onBack?: () => void;
  initialTeacherName?: string;
  initialStudentName?: string;
}) {
  const [teacherName, setTeacherName] = useState(initialTeacherName);
  const [studentName, setStudentName] = useState(initialStudentName);
  const [submitted, setSubmitted] = useState(false);

 const emptyRow = (): ExamRow => ({
  id: crypto.randomUUID(),

  tajweed1: null,
  tajweed2: null,

  nazira1: null,
  nazira2: null,

  hifz1: null,
  hifz2: null,

  hadith1: null,
  hadith2: null,

  duas: null,
  aqidah: null,
  fiqh: null,
  history: null,
  sirah: null,
});

  const [row, setRow] = useState<ExamRow>(emptyRow());

  const setField = (key: keyof ExamRow, val: number | null) =>
    setRow((r) => ({ ...r, [key]: val }));

  // Scoring
  const tajweedQaida =
  (row.tajweed1 ?? 0) +
  (row.tajweed2 ?? 0) +
  (row.nazira1 ?? 0) +
  (row.nazira2 ?? 0) +
  (row.hifz1 ?? 0) +
  (row.hifz2 ?? 0);

const islamicStudies =
  (row.hadith1 ?? 0) +
  (row.hadith2 ?? 0) +
  (row.duas ?? 0) +
  (row.aqidah ?? 0) +
  (row.fiqh ?? 0) +
  (row.history ?? 0) +
  (row.sirah ?? 0);

const total =
  tajweedQaida +
  islamicStudies;

  const allFilled = COLUMNS.every((c) => row[c.key as keyof ExamRow] !== null);

  const handleSubmit = () => {
    if (!teacherName.trim() || !studentName.trim() || !allFilled) return;
    setSubmitted(true);
  };

  const handleReset = () => {
    setRow(emptyRow());
    setTeacherName(initialTeacherName);
    setStudentName(initialStudentName);
    setSubmitted(false);
  };

  // ── Success Screen ──────────────────────────────────────────────────────────
  if (submitted) {
    const pct = Math.round((total / 100) * 100);
    const grade =
      pct >= 90 ? "Excellent" : pct >= 75 ? "Very Good" : pct >= 60 ? "Good" : pct >= 40 ? "Pass" : "Needs Improvement";
    const gradeColor =
      pct >= 90 ? "text-[#15803d]" : pct >= 75 ? "text-[#17a2b8]" : pct >= 60 ? "text-[#a16207]" : pct >= 40 ? "text-[#475569]" : "text-[#dc2626]";

    return (
      <div className="min-h-screen bg-[#f0f4f8] flex items-center justify-center p-6">
        <div className="bg-white rounded-2xl shadow-[0_2px_12px_rgba(0,0,0,.07)] max-w-md w-full p-8 text-center">
          <div className="w-16 h-16 rounded-full bg-[#dcfce7] flex items-center justify-center mx-auto mb-4">
            <CheckCircle size={32} className="text-[#22c55e]" />
          </div>
          <h2 className="text-2xl font-bold text-[#1e293b] mb-1">Exam Recorded</h2>
          <p className="text-[#94a3b8] text-sm mb-6">
            {studentName} · Examined by {teacherName}
          </p>
          <div className="grid grid-cols-3 gap-3 mb-6">
            <div className="rounded-xl bg-[#e8f8fb] p-3">
              <p className="text-xs text-[#475569] mb-1">Tajweed & Quran</p>
              <p className="text-lg font-bold text-[#17a2b8]">{tajweedQaida}<span className="text-xs font-normal text-[#94a3b8]">/50</span></p>
            </div>
            <div className="rounded-xl bg-[#e8f8fb] p-3">
              <p className="text-xs text-[#475569] mb-1">Islamic Studies</p>
              <p className="text-lg font-bold text-[#17a2b8]">{islamicStudies}<span className="text-xs font-normal text-[#94a3b8]">/50</span></p>
            </div>
            <div className="rounded-xl bg-[#dcfce7] p-3">
              <p className="text-xs text-[#475569] mb-1">Total</p>
              <p className="text-lg font-bold text-[#15803d]">{total}<span className="text-xs font-normal text-[#94a3b8]">/100</span></p>
            </div>
          </div>
          <p className={`text-2xl font-bold mb-6 ${gradeColor}`}>{grade}</p>
          <div className="flex gap-3">
            <button
              onClick={handleReset}
              className="flex-1 py-2.5 rounded-xl border border-[#e2e8f0] text-[#475569] text-sm font-medium hover:bg-[#f0f4f8] transition-colors"
            >
              New Exam
            </button>
