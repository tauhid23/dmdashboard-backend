// ── Dropdown Cell ─────────────────────────────────────────────────────────────
function DropdownCell({
  value,
  options,
  onChange,
}: {
  value: number | null;
  options: number[];
  onChange: (v: number | null) => void;
  max: number;
}) {
  return (
    <select
      value={value ?? ""}
      onChange={(e) =>
        onChange(e.target.value === "" ? null : Number(e.target.value))
      }
      className="w-full
min-w-[95px] rounded-lg border border-[#e2e8f0]
        bg-white px-2 py-2 text-center font-semibold text-sm text-[#1e293b]
        focus:outline-none focus:ring-2 focus:ring-[#17a2b8]
        focus:border-[#17a2b8]
        transition-all hover:border-[#17a2b8] hover:bg-[#e8f8fb]"
    >
      <option value="">—</option>
      {options.map((o) => (
        <option key={o} value={o}>
          {o}
        </option>
      ))}
    </select>
  );
}


