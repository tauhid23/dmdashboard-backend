          <div className="overflow-x-auto">
            <table className="w-full text-sm border-collapse min-w-[900px]">
              <thead>
                {/* Row 1: Subject group headers */}
                <tr>
  <th colSpan={2}
  className="bg-[#5f9ea0] text-white text-center font-semibold py-3 px-3 border border-[#4a8a8c] text-sm"
  >Tajweed</th>

  <th colSpan={2} className="bg-[#5f9ea0] text-white text-center font-semibold py-3 px-3 border border-[#4a8a8c] text-sm">Nazira</th>

  <th colSpan={2} className="bg-[#5f9ea0] text-white text-center font-semibold py-3 px-3 border border-[#4a8a8c] text-sm">Hifz</th>

  <th colSpan={2} className="bg-[#5f9ea0] text-white text-center font-semibold py-3 px-3 border border-[#4a8a8c] text-sm">Hadith & Akhlaq</th>

  <th className="bg-[#5f9ea0] text-white text-center font-semibold py-3 px-3 border border-[#4a8a8c] text-sm">Duas</th>

  <th className="bg-[#5f9ea0] text-white text-center font-semibold py-3 px-3 border border-[#4a8a8c] text-sm">Aqidah</th>

  <th className="bg-[#5f9ea0] text-white text-center font-semibold py-3 px-3 border border-[#4a8a8c] text-sm">Fiqh</th>

  <th className="bg-[#5f9ea0] text-white text-center font-semibold py-3 px-3 border border-[#4a8a8c] text-sm">History</th>

  <th className="bg-[#5f9ea0] text-white text-center font-semibold py-3 px-3 border border-[#4a8a8c] text-sm">Sirah</th>

</tr>

                {/* Row 2: Max marks */}
                <tr className="bg-[#e8f4f4]">
                  {COLUMNS.map((col) => (
                    <td
                      key={col.key}
                      className="text-center font-semibold text-[#1e293b] py-2 px-3 border border-[#cde0e0]"
