                  {COLUMNS.map((col) => (
                    <td key={col.key} className="px-2 py-2 border border-[#e2e8f0]">
                      <DropdownCell
                        value={row[col.key as keyof ExamRow] as number | null}
                        options={col.options}
                        onChange={(v) => setField(col.key as keyof ExamRow, v)}
                        max={col.maxMarks}
                      />
                    </td>
                  ))}
                </tr>
              </tbody>
            </table>
          </div>

          {/* Live score summary bar */}
          <div className="border-t border-slate-200 bg-slate-50 p-5">
            <div className="flex flex-col lg:flex-row gap-4 items-stretch">
              <div className="grid grid-cols-1 sm:grid-cols-3 gap-4 flex-1">
                <div className="bg-white rounded-2xl border border-cyan-100 shadow-sm p-4">
                  <p className="text-xs font-medium text-slate-500 uppercase tracking-wide">
