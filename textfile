// ── Types ────────────────────────────────────────────────────────────────────
interface SubjectColumn {
  key: string;
  label: string;
  maxMarks: number;
  description: string;
  options: number[];
}

interface ExamRow {
  id: string;
  qaidaQ1: number | null;
  qaidaQ2: number | null;
  nazira: number | null;
  hifz: number | null;
  hadithAkhlaq: number | null;
  duas: number | null;
  aqidah: number | null;
  fiqh: number | null;
  history: number | null;
  sirah: number | null;
}

// ── Helpers ──────────────────────────────────────────────────────────────────
const range = (max: number): number[] =>
  Array.from({ length: max + 1 }, (_, i) => i);

// ── Column Definitions ───────────────────────────────────────────────────────
const COLUMNS: SubjectColumn[] = [
  { key: "qaidaQ1",      label: "Qaida",          maxMarks: 15, description: "Q - 1",                        options: range(15) },
  { key: "qaidaQ2",      label: "Qaida",          maxMarks: 15, description: "Q - 2",                        options: range(15) },
  { key: "nazira",       label: "Nazira",         maxMarks: 10, description: "From Al-Fil to An-Nas",        options: range(10) },
  { key: "hifz",         label: "Hifz",           maxMarks: 10, description: "Al-Fatiha",                   options: range(10) },
  { key: "hadithAkhlaq", label: "Hadith & Akhlaq",maxMarks: 10, description: "5 Hadith with meaning and 1 Moral", options: range(10) },
  { key: "duas",         label: "Duas",           maxMarks: 10, description: "10 Duas with meaning",        options: range(10) },
  { key: "aqidah",       label: "Aqidah",         maxMarks: 10, description: "Any 1 Question",              options: range(10) },
  { key: "fiqh",         label: "Fiqh",           maxMarks: 10, description: "Any 1 Question",              options: range(10) },
  { key: "history",      label: "History",        maxMarks:  5, description: "Story of Nabi Adam",          options: range(5)  },
  { key: "sirah",        label: "Sirah",          maxMarks:  5, description: "Story of Nabi Mohammad (SAW)",options: range(5)  },
];

// Group headers for the top row
// const QAIDA_COLS = ["qaidaQ1", "qaidaQ2"];

// ── Dropdown Cell ─────────────────────────────────────────────────────────────
function DropdownCell({
  value,
  options,
  onChange,
}: {
  value: number | null;
  options: number[];
  onChange: (v: number | null) => void;
  max: number;
}) {
  return (
    <select
      value={value ?? ""}
      onChange={(e) => onChange(e.target.value === "" ? null : Number(e.target.value))}
      className="w-full min-w-[70px] rounded-lg border border-[#e2e8f0]
        bg-white px-2 py-2 text-center font-semibold text-sm text-[#1e293b]
        focus:outline-none focus:ring-2 focus:ring-[#17a2b8]
        focus:border-[#17a2b8]
        transition-all hover:border-[#17a2b8] hover:bg-[#e8f8fb]"
    >
      <option value="">—</option>
      {options.map((o) => (
        <option key={o} value={o}>
          {o}
        </option>
      ))}
    </select>
  );
}


